---
---

<section id="projects">
  <div class="container">
    <h2>My Projects</h2>
    <div class="projects-grid">
      <div class="project-card">
        <div class="project-image">
          <img src="/placeholder-project1.jpg" alt="E-commerce Platform" />
          <div class="project-overlay">
            <div class="project-links">
              <a href="#" class="project-link">Live Demo</a>
              <a href="#" class="project-link">GitHub</a>
            </div>
          </div>
        </div>
        <div class="project-content">
          <h3>E-commerce Platform</h3>
          <p>A full-stack e-commerce solution built with React, Node.js, and PostgreSQL. Features include user authentication, payment processing, and admin dashboard.</p>
          <div class="project-tech">
            <span class="tech-tag">React</span>
            <span class="tech-tag">Node.js</span>
            <span class="tech-tag">PostgreSQL</span>
            <span class="tech-tag">Stripe</span>
          </div>
        </div>
      </div>

      <div class="project-card">
        <div class="project-image">
          <img src="/placeholder-project2.jpg" alt="Task Management App" />
          <div class="project-overlay">
            <div class="project-links">
              <a href="#" class="project-link">Live Demo</a>
              <a href="#" class="project-link">GitHub</a>
            </div>
          </div>
        </div>
        <div class="project-content">
          <h3>Task Management App</h3>
          <p>A collaborative task management application with real-time updates, drag-and-drop functionality, and team collaboration features.</p>
          <div class="project-tech">
            <span class="tech-tag">Vue.js</span>
            <span class="tech-tag">Firebase</span>
            <span class="tech-tag">Tailwind CSS</span>
          </div>
        </div>
      </div>

      <div class="project-card">
        <div class="project-image">
          <img src="/placeholder-project3.jpg" alt="Weather Dashboard" />
          <div class="project-overlay">
            <div class="project-links">
              <a href="#" class="project-link">Live Demo</a>
              <a href="#" class="project-link">GitHub</a>
            </div>
          </div>
        </div>
        <div class="project-content">
          <h3>Weather Dashboard</h3>
          <p>An interactive weather dashboard that displays current conditions and forecasts with beautiful data visualizations and location-based services.</p>
          <div class="project-tech">
            <span class="tech-tag">JavaScript</span>
            <span class="tech-tag">Chart.js</span>
            <span class="tech-tag">OpenWeather API</span>
          </div>
        </div>
      </div>

      <div class="project-card">
        <div class="project-image">
          <img src="/placeholder-project4.jpg" alt="Portfolio Website" />
          <div class="project-overlay">
            <div class="project-links">
              <a href="#" class="project-link">Live Demo</a>
              <a href="#" class="project-link">GitHub</a>
            </div>
          </div>
        </div>
        <div class="project-content">
          <h3>Portfolio Website</h3>
          <p>A responsive portfolio website built with Astro and modern CSS. Features smooth animations, optimized performance, and SEO best practices.</p>
          <div class="project-tech">
            <span class="tech-tag">Astro</span>
            <span class="tech-tag">CSS</span>
            <span class="tech-tag">JavaScript</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #projects {
    padding: 6rem 2rem;
    background: #ffffff;
    border-top: 1px solid #f0f0f0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  h2 {
    font-size: 2.2rem;
    text-align: center;
    margin-bottom: 4rem;
    color: #1a1a1a;
    font-weight: 300;
    letter-spacing: -0.01em;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .project-card {
    background: #fafafa;
    border: 1px solid #e5e5e5;
    overflow: hidden;
  }

  .project-image {
    height: 180px;
    overflow: hidden;
    background: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid #e5e5e5;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-content {
    padding: 1.5rem;
  }

  .project-content h3 {
    font-size: 1.2rem;
    margin-bottom: 1rem;
    color: #1a1a1a;
    font-weight: 400;
  }

  .project-content p {
    color: #666666;
    line-height: 1.6;
    margin-bottom: 1.2rem;
    font-size: 0.95rem;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-tag {
    background: #e5e5e5;
    color: #666666;
    padding: 0.3rem 0.6rem;
    border-radius: 0;
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.01em;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }

    h2 {
      font-size: 2rem;
    }
  }
</style>